<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                  https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="ErgoSarapu\DonationBundle\BCIdentities\Application\Query\Model\ClaimPresentation" table="projection_claim_presentation">
        <id name="id" type="integer" column="id">
            <generator strategy="AUTO" />
        </id>
        <many-to-one field="claim" target-entity="ErgoSarapu\DonationBundle\BCIdentities\Application\Query\Model\Claim" inversed-by="presentations">
            <join-column name="claim_id" referenced-column-name="claim_id" nullable="false" on-delete="CASCADE" />
        </many-to-one>
        <field name="attributeType" type="string" column="attribute_type" length="64" />
        <field name="value" type="string" column="attribute_value" length="255" nullable="true" />
        <field name="evidenceLevel" type="string" column="evidence_level" length="20" />

        <unique-constraints>
            <unique-constraint name="uniq_projection_claim_presentation_claim_and_attribute_type" columns="claim_id,attribute_type" />
        </unique-constraints>
        <indexes>
            <index name="idx_projection_claim_presentation_attribute_value" columns="attribute_type,attribute_value" />
            <index name="idx_projection_claim_presentation_evidence_level" columns="evidence_level" />
        </indexes>
    </entity>
</doctrine-mapping>
