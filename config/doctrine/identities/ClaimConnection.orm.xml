<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                  https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="ErgoSarapu\DonationBundle\BCIdentities\Application\Query\Model\ClaimConnection" table="projection_claim_connection">
        <id name="id" type="integer" column="id">
            <generator strategy="AUTO" />
        </id>
        <many-to-one field="claim" target-entity="ErgoSarapu\DonationBundle\BCIdentities\Application\Query\Model\Claim" inversed-by="connections">
            <join-column name="claim_id" referenced-column-name="claim_id" nullable="false" on-delete="CASCADE" />
        </many-to-one>
        <field name="connectedClaimId" type="string" column="connected_claim_id" length="36" />
        <field name="reason" type="string" column="reason" length="64" />

        <unique-constraints>
            <unique-constraint name="uniq_projection_claim_connection" columns="claim_id,connected_claim_id,reason" />
        </unique-constraints>
        <indexes>
            <index name="idx_projection_claim_connection_claim_id" columns="claim_id" />
            <index name="idx_projection_claim_connection_connected_claim_id" columns="connected_claim_id" />
            <index name="idx_projection_claim_connection_reason" columns="reason" />
        </indexes>
    </entity>
</doctrine-mapping>
