<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                  https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="ErgoSarapu\DonationBundle\BCIdentities\Application\Query\Model\ClaimCorrelatedSource" table="projection_claim_correlated_source">
        <id name="id" type="integer" column="id">
            <generator strategy="AUTO" />
        </id>
        <many-to-one field="claim" target-entity="ErgoSarapu\DonationBundle\BCIdentities\Application\Query\Model\Claim" inversed-by="correlatedSources">
            <join-column name="claim_id" referenced-column-name="claim_id" nullable="false" on-delete="CASCADE" />
        </many-to-one>
        <field name="correlatedSourceId" type="string" column="correlated_source_id" length="36" />

        <unique-constraints>
            <unique-constraint name="uniq_projection_claim_corr_src" columns="claim_id,correlated_source_id" />
        </unique-constraints>
        <indexes>
            <index name="idx_projection_claim_correlated_source_correlated_source_id" columns="correlated_source_id" />
        </indexes>
    </entity>
</doctrine-mapping>
