<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                  https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="ErgoSarapu\DonationBundle\BCIdentities\Application\Query\Model\Claim" table="projection_claim">
        <id name="claimId" type="string" column="claim_id" length="36" />
        <one-to-many field="correlatedSources" target-entity="ErgoSarapu\DonationBundle\BCIdentities\Application\Query\Model\ClaimCorrelatedSource" mapped-by="claim" orphan-removal="true">
            <cascade>
                <cascade-persist />
                <cascade-remove />
            </cascade>
            <order-by>
                <order-by-field name="id" direction="ASC" />
            </order-by>
        </one-to-many>
        <one-to-many field="linkedClaims" target-entity="ErgoSarapu\DonationBundle\BCIdentities\Application\Query\Model\ClaimLinkedClaim" mapped-by="claim" orphan-removal="true">
            <cascade>
                <cascade-persist />
                <cascade-remove />
            </cascade>
            <order-by>
                <order-by-field name="id" direction="ASC" />
            </order-by>
        </one-to-many>
        <one-to-many field="presentations" target-entity="ErgoSarapu\DonationBundle\BCIdentities\Application\Query\Model\ClaimPresentation" mapped-by="claim" orphan-removal="true">
            <cascade>
                <cascade-persist />
                <cascade-remove />
            </cascade>
            <order-by>
                <order-by-field name="id" direction="ASC" />
            </order-by>
        </one-to-many>

        <field name="sourceContext" type="string" column="source_context" length="100" />
        <field name="sourceId" type="string" column="source_id" length="36" nullable="false" />
        <field name="sourceType" type="string" column="source_type" length="100" nullable="true" />

        <field name="identityId" type="string" column="identity_id" length="36" nullable="true" />

        <indexes>
            <index name="idx_projection_claim_source_context" columns="source_context" />
            <index name="idx_projection_claim_source_id" columns="source_id" />
            <index name="idx_projection_claim_identity_id" columns="identity_id" />
        </indexes>
    </entity>
</doctrine-mapping>
